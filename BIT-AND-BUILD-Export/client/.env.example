# Public Supabase values for the Vite frontend. Set these in your deployment
# platform's client/build environment variables as well, then redeploy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: URL of the separately deployed API used for organizer/judge login.
VITE_API_URL=https://your-api.example.com
