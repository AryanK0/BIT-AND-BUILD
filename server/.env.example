NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=bb_session
SESSION_TTL_HOURS=8
UPLOAD_DIR=./private/uploads
ORGANIZER_EMAIL=admin@example.com
ORGANIZER_PASSWORD=replace-with-a-strong-password
JUDGE_ID=JUDGE-001
# 64 random hexadecimal characters. Required for Admin team import and password recovery.
# This is not a Google Sheets credential. Generate it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEAM_CREDENTIAL_ENCRYPTION_KEY=
